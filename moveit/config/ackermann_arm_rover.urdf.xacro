<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ackermann_arm_rover">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import ackermann_arm_rover urdf file -->
    <xacro:include filename="$(find pincer_gripper_description)/urdf/pincer.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="ackermann_arm_rover.ros2_control.xacro" />


    <xacro:ackermann_arm_rover_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
